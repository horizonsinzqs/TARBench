{
  "model": "gpt-5.4",
  "temperature": 0,
  "batch_size": 5,
  "sample_count": 20,
  "dataset_file": "../datasets/icl_dataset.json",
  "library_file": "library/icl_library.json",
  "prompt_file": "icl_prompt.md",
  "output_dir": "outputs",
  "shot_mix": {
    "1": {
      "benign": 0,
      "abnormal": 1
    },
    "3": {
      "benign": 1,
      "abnormal": 2
    },
    "5": {
      "benign": 2,
      "abnormal": 3
    }
  },
  "max_retries": 5,
  "type_definition_limit": 14
}
